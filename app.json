{
  "expo": {
    "name": "TimeCapsule",
    "slug": "TimeCapsule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "timecapsule",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow TimeCapsule to access your photos to attach memories to capsules.",
        "NSFaceIDUsageDescription": "Face ID is used to unlock capsules you've protected."
      }
    },
    "android": {
      "minSdkVersion": 24,
      "adaptiveIcon": {
        "backgroundColor": "#F2EFEA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.nati2362.TimeCapsule"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "backgroundColor": "#F2EFEA",
      "resizeMode": "contain",
      "image": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2EFEA",
          "resizeMode": "contain",
          "image": "./assets/images/logo.png",
          "android": {
            "imageWidth": 120
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#82B090"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TimeCapsule to access your photos to attach memories to capsules."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9afd424-b203-44a4-81f0-e62c1318316d"
      }
    }
  }
}
